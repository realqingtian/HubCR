# Control plane
HUBCR_API_ADDRESS=127.0.0.1:8080
HUBCR_SHUTDOWN_TIMEOUT=10s
HUBCR_DATABASE_URL=postgres://hubcr:hubcr-dev-only@localhost:5432/hubcr?sslmode=disable
HUBCR_DATABASE_CONNECT_TIMEOUT=5s
HUBCR_DATABASE_HEALTH_TIMEOUT=2s
HUBCR_DATABASE_MAX_CONNECTIONS=10
HUBCR_SESSION_TTL=24h
# Local HTTP only. Shared and production deployments must use HTTPS and set this true.
HUBCR_SESSION_COOKIE_SECURE=false
# Direct API startup is fail-closed by default. `make dev-api` enables local Registry
# auth and supplies ignored development key paths generated by `registry-dev-keys`.
HUBCR_REGISTRY_AUTH_ENABLED=false
HUBCR_REGISTRY_EXTERNAL_URL=
HUBCR_REGISTRY_ALLOW_INSECURE_HTTP=false
HUBCR_REGISTRY_SERVICE=hubcr-registry
HUBCR_REGISTRY_ISSUER=hubcr-token-service
HUBCR_REGISTRY_TOKEN_TTL=5m
# Required as an absolute, read-only secret-mounted path when auth is enabled.
HUBCR_REGISTRY_TOKEN_PRIVATE_KEY_FILE=
# Required trust set; must contain the active public key and may retain retiring keys.
HUBCR_REGISTRY_TOKEN_JWKS_FILE=
# Shared only between Distribution and the control-plane notification endpoint.
# `make registry-dev-keys` generates the ignored local value; shared deployments
# must inject an independent value of at least 32 visible ASCII characters.
HUBCR_REGISTRY_EVENT_TOKEN=

# Worker
HUBCR_WORKER_POLL_INTERVAL=5s

# Web
# Next.js proxies same-origin /api requests to this server-only control-plane origin.
HUBCR_CONTROL_PLANE_URL=http://127.0.0.1:8080

# Infrastructure
POSTGRES_DB=hubcr
POSTGRES_USER=hubcr
POSTGRES_PASSWORD=hubcr-dev-only
MINIO_ROOT_USER=hubcr
MINIO_ROOT_PASSWORD=hubcr-dev-only
HUBCR_REGISTRY_PORT=5000
# Localhost-only Distribution debug server with Prometheus and notification queue metrics.
HUBCR_REGISTRY_DEBUG_PORT=5002
HUBCR_POSTGRES_PORT=5432
HUBCR_REDIS_PORT=6379
HUBCR_MINIO_PORT=9000
HUBCR_MINIO_CONSOLE_PORT=9001
