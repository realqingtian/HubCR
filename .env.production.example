# Copy this file to `.env.production`, protect it as a secret-bearing operator file,
# and replace every blank required value before using the production Compose targets.

# Supported single-host Compose entry point. A trusted HTTPS reverse proxy must
# forward the public origin to this loopback listener.
HUBCR_GATEWAY_BIND_ADDRESS=127.0.0.1
HUBCR_GATEWAY_PORT=5000
HUBCR_REGISTRY_EXTERNAL_URL=https://registry.example.com

# Durable PostgreSQL state. URL-encode reserved characters in HUBCR_DATABASE_URL.
POSTGRES_DB=hubcr
POSTGRES_USER=hubcr
POSTGRES_PASSWORD=
HUBCR_DATABASE_URL=

# Durable OCI object storage.
MINIO_ROOT_USER=hubcr
MINIO_ROOT_PASSWORD=

# Absolute host directory containing private.pem and jwks.json. Keep it outside
# backups and source control. Inject the independent event token through the
# protected operator environment.
HUBCR_REGISTRY_AUTH_DIR=
HUBCR_REGISTRY_EVENT_TOKEN=

# Application runtime.
HUBCR_SESSION_COOKIE_SECURE=true
HUBCR_REGISTRY_SERVICE=hubcr-registry
HUBCR_REGISTRY_ISSUER=hubcr-token-service
HUBCR_REGISTRY_TOKEN_TTL=5m
HUBCR_API_IMAGE=hubcr-api:local
HUBCR_WEB_IMAGE=hubcr-web:local
HUBCR_WORKER_POLL_INTERVAL=5s
HUBCR_WORKER_LEASE_DURATION=15m
HUBCR_WORKER_JOB_TIMEOUT=10m
HUBCR_WORKER_SHUTDOWN_TIMEOUT=20s
HUBCR_WORKER_RETRY_BASE=5s
HUBCR_WORKER_RETRY_MAX=5m
HUBCR_WORKER_MAX_CONCURRENCY=2
HUBCR_SECURITY_SCANNER_ENABLED=true
HUBCR_SECURITY_REPAIR_INTERVAL=30s
HUBCR_SECURITY_REPAIR_BATCH=100
